const { body, validationResult } = require("express-validator");

exports.validateLabTest = [
  body("name").notEmpty().withMessage("Name is required"),
  body("description").notEmpty().withMessage("Description is required"),
  body("cost").isNumeric().withMessage("Cost must be a number"),
  (req, res, next) => {
    const errors = validationResult(req);
    if (!errors.isEmpty())
      return res.status(400).json({ errors: errors.array() });
    next();
  },
];

exports.validateLabTestResult = [
  body("results")
    .isArray({ min: 1 })
    .withMessage("Results must be a non-empty array"),
  body("results.*.testName")
    .notEmpty()
    .withMessage("Each test must have a testName"),
  body("results.*.result")
    .notEmpty()
    .withMessage("Each test must have a result"),
  (req, res, next) => {
    const errors = validationResult(req);
    if (!errors.isEmpty())
      return res.status(400).json({ errors: errors.array() });
    next();
  },
];
